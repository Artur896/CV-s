# Proveedor de IA (Groq - API compatible con OpenAI)
# Deja GROQ_API_KEY vacio para correr la app en "modo sin IA" (preguntas y CV por plantilla).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER=groq

# Limites de consumo de IA (control de costos)
MAX_AI_REQUESTS_PER_INTERVIEW=8
MAX_AI_REQUESTS_PER_DAY=50
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=600

# Servidor
PORT=4810
# Origen permitido para CORS en producción (ej: https://mi-app.vercel.app). Vacío = cualquier origen.
CORS_ORIGIN=

# Base de datos SQLite (desarrollo local; ruta relativa a server/). Se ignora si DATABASE_URL está definida.
DB_PATH=./data/app.sqlite

# Postgres/Supabase (producción). Si se define, el backend usa Postgres en vez de SQLite.
# Usa el connection string del "Connection pooling" (modo transaction, puerto 6543) de Supabase,
# no el directo (puerto 5432): las funciones serverless de Vercel abren muchas conexiones cortas
# y el pooler evita agotar las conexiones de Postgres.
DATABASE_URL=
